<?xml version="1.0" encoding="utf-8"?>
<!-- splash.xml — Launch / Capacitor splash fallback. Changes: solid paper
     fill. Theme.SplashScreen and the splash plugin both reference
     @drawable/splash; a missing bitmap left a broken-image header on
     Android (app icon + truncated "Space Swoosh"). Replace with a PNG
     from `npm run assets:sync` when shipping branded splash art. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/splash_background" />
</shape>
