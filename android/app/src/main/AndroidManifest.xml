<?xml version="1.0" encoding="utf-8" ?>
<!-- AndroidManifest.xml — Capacitor host. Changes: windowSoftInputMode is
     adjustNothing so Gboard overlays the WebView; Submit Signal layouts from
     Cap Keyboard height instead of shrinking the canvas (adjustResize + IME
     height was double-counting and crushing the card). Play Games APP_ID
     meta-data. Activity label is blank so a caption bar cannot print "Spac…";
     application app_name stays Space Swoosh for the drawer / recents. Drop
     screenOrientation portrait lock (Play large-screen); 2:3 letterbox is CSS.
     Strip AD_ID. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme">
        <!-- Portrait fill / landscape 2:3 letterbox is CSS. configChanges
             keeps the WebView alive across rotation so a run does not restart. -->
        <!-- adjustNothing: IME overlays. Submit Signal reads keyboard height
             and paints in the remaining canvas (resize/pan crushed or desynced
             the DOM call-sign field). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            tools:ignore="EmptyLabel"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Gameplay analytics only — no Advertising ID (Play Data Safety). -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <!-- Play Games Services APP_ID from games-ids.xml (Firebase project number). -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wall-boop haptic tick (@capacitor/haptics also declares this; keep
         explicit so a merge miss never silently drops vibration). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Firebase Analytics merges AD_ID via play-services; remove so Play Console
         "Does your app use an advertising ID? → No" matches the uploaded AAB. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
</manifest>
