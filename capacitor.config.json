{
  "appId": "com.orbi.spaceswoosh",
  "appName": "Space Swoosh",
  "webDir": "dist",
  "backgroundColor": "#e1d9c1",
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#e1d9c1",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  },
  "android": {
    "backgroundColor": "#e1d9c1",
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "backgroundColor": "#e1d9c1",
    "contentInset": "never",
    "scrollEnabled": false
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/analytics": {
            "symlink": true
          }
        }
      }
    }
  }
}
